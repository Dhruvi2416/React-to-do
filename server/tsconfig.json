{
  "compilerOptions": {
    "target": "ES6",
    "module": "CommonJS",
    "types": ["node", "express"],
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types", "./types"]
  },
  "include": ["./types", ".", "./**/*.ts"],
  "exclude": ["node_modules"]
}
